# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Hero storage (translated files) + db
storage/
dev.db

# agents/ (Python FastAPI service)
agents/__pycache__/
agents/**/__pycache__/
*.pyc
agents/.venv/
agents/venv/
agents/data/uploads/*
!agents/data/uploads/.gitkeep
agents/data/chroma/*
!agents/data/chroma/.gitkeep

# local AI-tool config, not part of the project
agents/data/conversations/*
agents/data/tarjuman_cache.json
agents/benchmarks/results/
agents/benchmarks/*.log
agents/.pytest_cache/

# generated by `next dev`; not part of the project
AGENTS.md
