# Local Hero — copy this file to .env and fill in real values.
DATABASE_URL="mysql://localhero:localhero_pw@localhost:3306/localhero"

# Session signing secret — change to a long random string.
AUTH_SECRET="change-me-to-a-long-random-string"

# The FastAPI agents service (General Assistant / File Analyst / Auto / Tarjuman).
AGENTS_URL="http://localhost:9099"

# Google sign-in — from Google Cloud Console > APIs & Services > Credentials.
# Redirect URI registered there must match GOOGLE_REDIRECT_URI exactly.
# Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
